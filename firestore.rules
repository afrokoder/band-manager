rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function authed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return authed() && 'admin' in userDoc().get('groups', []);
    }

    function inGroup(group) {
      return authed() && group in userDoc().get('groups', []);
    }

    // Admin OR band member can manage content
    function canManage() {
      return isAdmin() || inGroup('band');
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user can read profiles (needed for member lists)
      allow read: if authed();

      // FCM token updates — any user can update only their own token field
      allow update: if authed()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['fcmToken']);

      // Profile creation — no self-granting admin
      allow create: if authed()
                    && request.auth.uid == userId
                    && !('admin' in request.resource.data.get('groups', []));

      // Profile update — non-admin users updating their own profile
      // Cannot add or retain admin via this path
      allow update: if authed()
                    && request.auth.uid == userId
                    && !('admin' in resource.data.get('groups', []))
                    && !('admin' in request.resource.data.get('groups', []));

      // Admins can write any profile (grant/revoke admin, edit any field)
      allow write: if isAdmin();
    }

    // ── Songs ─────────────────────────────────────────────────────────────────
    match /songs/{id} {
      allow read: if authed();

      // Any signed-in user may add a song they created (needed when a song is
      // added manually while building a set list). Existing songs remain
      // manager-controlled.
      allow create: if authed()
                    && request.resource.data.addedBy == request.auth.uid;
      allow update, delete: if canManage();
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    match /messages/{id} {
      allow read: if authed();

      // Create — sender must be the authenticated user, text capped at 2000 chars
      allow create: if authed()
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text.size() <= 2000;

      // Update (edit) — own message or admin, text still capped
      allow update: if authed()
                    && (request.auth.uid == resource.data.senderId || isAdmin())
                    && request.resource.data.text.size() <= 2000;

      // Delete — own message or admin
      allow delete: if authed()
                    && (request.auth.uid == resource.data.senderId || isAdmin());
    }

    // ── Rehearsals ────────────────────────────────────────────────────────────
    match /rehearsals/{id} {
      allow read:           if authed();
      allow create, delete: if canManage();

      // Full update for managers, OR own-RSVP-only update for members
      allow update: if canManage()
                    || (authed()
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['rsvp'])
                        && request.resource.data.rsvp.diff(resource.data.rsvp)
                             .affectedKeys().hasOnly([request.auth.uid]));
    }

    // ── Services ──────────────────────────────────────────────────────────────
    match /services/{id} {
      allow read:  if authed();
      allow write: if canManage();
    }

    // ── Setlists ──────────────────────────────────────────────────────────────
    match /setlists/{id} {
      // Drafts are private to their creator.
      // Published/submitted set lists are visible to the whole signed-in team.
      allow read: if authed()
                  && (resource.data.status in ['published', 'submitted']
                      || resource.data.createdBy == request.auth.uid);

      allow create: if authed()
                    && request.resource.data.createdBy == request.auth.uid;

      // Upcoming set lists can be changed or deleted by the creator or an admin.
      // Adding one day keeps the set editable for the service date itself.
      allow update, delete: if authed()
                            && (resource.data.createdBy == request.auth.uid || isAdmin())
                            && resource.data.serviceDateTs + 86400000 > request.time.toMillis();
    }

    // Per-open audit records. Any signed-in viewer can record their own view.
    // Only the set-list creator or an admin can read the view history.
    match /setlists/{setlistId}/views/{viewId} {
      allow create: if authed()
                    && request.resource.data.viewerId == request.auth.uid
                    && get(/databases/$(database)/documents/setlists/$(setlistId)).data.status in ['published', 'submitted'];
      allow read: if authed()
                  && (get(/databases/$(database)/documents/setlists/$(setlistId)).data.createdBy == request.auth.uid
                      || isAdmin());
      allow update, delete: if false;
    }

    // One schedule item per calendar date. These reservation documents make
    // duplicate prevention atomic even when two managers save at the same time.
    match /serviceDateSlots/{dateKey} {
      allow read: if authed();
      allow write: if canManage();
    }

    match /rehearsalDateSlots/{dateKey} {
      allow read: if authed();
      allow write: if canManage();
    }

    // Deterministic service/section reservation used to guarantee that only one
    // published set list can be attached to a service section at a time.
    match /setlistSlots/{slotId} {
      allow read: if authed();
      allow create: if authed()
                    && (request.resource.data.createdBy == request.auth.uid || isAdmin())
                    && getAfter(/databases/$(database)/documents/setlists/$(request.resource.data.setlistId)).data.status == 'published';
      allow update: if false;
      allow delete: if authed()
                    && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ── Settings: Pinboard ────────────────────────────────────────────────────
    match /settings/pinboard {
      allow read:  if authed();
      allow write: if isAdmin();
    }

    // ── Settings: Org ────────────────────────────────────────────────────────
    // Public read — needed to validate access code before auth exists
    match /settings/org {
      allow read:  if true;
      allow write: if isAdmin();
    }
  }
}
