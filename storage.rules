rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Content-types a browser will execute as active content when opened as a
    // top-level document (HTML/JS, SVG scripts, XML). Blocking exactly these —
    // rather than allowlisting media — keeps arbitrary "team file" uploads
    // (pdf, docx, zip, txt, audio, images) working while removing the only path
    // by which an uploaded file could run script in a viewer's browser.
    function dangerousType(t) {
      return t != null
             && t.matches('(text/html|application/xhtml\\+xml|image/svg\\+xml|application/xml|text/xml).*');
    }

    // Server-side enforcement of the same limits the client UI applies, so a
    // raw-SDK/REST client cannot bypass them (size cap + no executable types).
    function validUpload() {
      return request.auth != null
             && request.resource.size < 100 * 1024 * 1024
             && !dangerousType(request.resource.contentType);
    }

    match /songs/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if validUpload() && request.auth.uid == userId;
    }

    match /setlists/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if validUpload() && request.auth.uid == userId;
    }
  }
}
